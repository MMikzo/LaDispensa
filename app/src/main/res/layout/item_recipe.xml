<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/home_card"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textRecipeItalianName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPAGHETTI AGLIO E OLIO"
        android:textColor="@color/deep_olive"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:id="@+id/textRecipeEnglishName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Garlic and Oil Spaghetti"
        android:textColor="@color/stone"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textRecipeIngredientCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="6 ingredients"
        android:textColor="@color/wine"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="VIEW RECIPE  →"
        android:textColor="@color/olive"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>