<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/home_card"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textIngredientName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tomatoes"
        android:textColor="@color/espresso"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textIngredientCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Vegetables"
        android:textColor="@color/stone"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/buttonEditIngredient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="EDIT"
            android:textColor="@color/olive"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonDeleteIngredient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="8dp"
            android:text="DELETE"
            android:textColor="@color/wine"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>