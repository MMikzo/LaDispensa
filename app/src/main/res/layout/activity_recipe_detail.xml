<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="42dp"
        android:paddingEnd="28dp"
        android:paddingBottom="42dp">

        <TextView
            android:id="@+id/textDetailItalianName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CACIO E PEPE"
            android:textColor="@color/espresso"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/textDetailEnglishName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Cheese and Pepper Pasta"
            android:textColor="@color/stone"
            android:textSize="16sp" />

        <View
            android:layout_width="54dp"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:background="@color/wine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="INGREDIENTS · INGREDIENTI"
            android:textColor="@color/deep_olive"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/textDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="6dp"
            android:text="Spaghetti&#10;Pecorino Romano&#10;Black pepper&#10;Salt"
            android:textColor="@color/espresso"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="PREPARATION · PREPARAZIONE"
            android:textColor="@color/deep_olive"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/textDetailInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="6dp"
            android:text="Cooking instructions appear here."
            android:textColor="@color/espresso"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="44dp"
            android:text="Buon appetito."
            android:textColor="@color/stone"
            android:textSize="14sp"
            android:textStyle="italic" />

    </LinearLayout>

</ScrollView>