<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- A restrained border keeps the cards closer to a printed menu
         than the usual raised Android button style. -->
    <solid android:color="@color/warm_white" />

    <stroke
        android:width="1dp"
        android:color="@color/soft_border" />

    <corners android:radius="14dp" />

    <padding
        android:left="20dp"
        android:top="18dp"
        android:right="20dp"
        android:bottom="18dp" />

</shape>